{
  "name": "@nage/forma",
  "version": "6.0.0",
  "description": "FORMA — a museum-grade, token-driven design system. One CSS file, 55 contrast-proven themes, accessible components, AI-native docs.",
  "main": "dist/forma.esm.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "lint": "node bin/forma.mjs lint --css site/assets/site.css \"site/**/*.html\"",
    "preview": "npx -y serve site"
  },
  "author": "Ömer Asım",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "axe-core": "^4.10.2",
    "esbuild": "^0.24.0",
    "lucide-static": "^0.460.0"
  },
  "type": "module",
  "module": "dist/forma.esm.js",
  "style": "dist/forma.css",
  "unpkg": "dist/forma.min.js",
  "files": [
    "dist",
    "lib",
    "mcp",
    "bin",
    "themes",
    "tokens",
    "llms.txt",
    "llms-full.txt",
    "forma-spec.json",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "forma": "bin/forma.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "design-system",
    "css",
    "tokens",
    "accessibility",
    "themes",
    "llms.txt",
    "mcp"
  ],
  "exports": {
    ".": {
      "import": "./dist/forma.esm.js",
      "default": "./dist/forma.min.js"
    },
    "./css": "./dist/forma.css",
    "./dist/*": "./dist/*",
    "./themes/*": "./dist/themes/*",
    "./spec": "./forma-spec.json",
    "./lint": "./lib/lint.mjs",
    "./color": "./lib/color.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omerasim/forma.git"
  },
  "homepage": "https://forma-design-five.vercel.app"
}
